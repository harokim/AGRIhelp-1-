rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function isEngineer() {
      return userExists()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "engineer"
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == "active";
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if signedIn();

      // User profiles are created through trusted Admin SDK functions.
      allow create: if false;

      allow update: if isEngineer()
        || (
          isOwner(userId)
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "name",
              "contactNumber",
              "address",
              "officeAddress",
              "barangay",
              "municipality",
              "province",
              "region",
              "position",
              "profileBio",
              "avatar",
              "updatedAt"
            ])
        );

      allow delete: if false;
    }

    match /accountRequests/{accountRequestId} {
      allow read: if isEngineer();

      // Submission and processing use callable functions.
      allow create, update, delete: if false;
    }

    match /requests/{requestId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid;

      allow update: if isEngineer()
        || (
          signedIn()
          && resource.data.clientId == request.auth.uid
        );

      allow delete: if isEngineer();
    }

    match /documents/{documentId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid;

      allow update: if isEngineer()
        || (
          signedIn()
          && resource.data.clientId == request.auth.uid
        );

      allow delete: if isEngineer();

      match /chunks/{chunkId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update, delete: if isEngineer();
      }
    }

    match /reportDocuments/{documentId} {
      allow read: if signedIn();

      allow create: if isEngineer()
        && request.resource.data.engineerId == request.auth.uid;

      allow update, delete: if isEngineer();

      match /chunks/{chunkId} {
        allow read, create, update, delete: if isEngineer();
      }
    }

    match /appointments/{appointmentId} {
      allow read: if signedIn();

      allow create: if isEngineer()
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if isEngineer();
    }

    match /blockedDates/{dateId} {
      allow read: if signedIn();

      allow create: if isEngineer()
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if isEngineer();
    }

    match /notifications/{notificationId} {
      allow read: if isEngineer()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow create: if signedIn();

      allow update, delete: if isEngineer()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );
    }

    match /messages/{messageId} {
      allow read: if isEngineer()
        || (
          signedIn()
          && request.auth.uid in resource.data.participants
        );

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants;

      allow update, delete: if isEngineer()
        || (
          signedIn()
          && request.auth.uid in resource.data.participants
        );
    }
  }
}