rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function isEngineer() {
      return userExists()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "engineer"
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == "active";
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validAccountRequest() {
      let data = request.resource.data;

      return data.keys().hasAll([
          "name",
          "email",
          "contactNumber",
          "association",
          "associationKey",
          "members",
          "year",
          "position",
          "region",
          "province",
          "municipality",
          "barangay",
          "status",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "name",
          "email",
          "contactNumber",
          "association",
          "associationKey",
          "members",
          "year",
          "position",
          "region",
          "province",
          "municipality",
          "barangay",
          "status",
          "createdAt",
          "updatedAt"
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 150
        && data.email is string
        && data.email.size() <= 254
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.contactNumber is string
        && data.contactNumber.matches('^09[0-9]{9}$')
        && data.association is string
        && data.association.size() > 0
        && data.association.size() <= 200
        && data.associationKey is string
        && data.associationKey.size() > 0
        && data.associationKey.size() <= 200
        && data.members is int
        && data.members >= 0
        && (data.year == null || data.year is int)
        && data.position is string
        && data.position.size() > 0
        && data.region is string
        && data.region.size() > 0
        && data.province is string
        && data.province.size() > 0
        && data.municipality is string
        && data.municipality.size() > 0
        && data.barangay is string
        && data.barangay.size() > 0
        && data.status == "pending"
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isEngineer()
        || isOwner(userId)
        || (
          signedIn()
          && resource.data.role == "engineer"
        );

      allow create: if isEngineer()
        && userId != request.auth.uid
        && request.resource.data.role == "client"
        && request.resource.data.status == "active"
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.contactNumber is string
        && request.resource.data.keys().hasOnly([
          "name",
          "email",
          "role",
          "contactNumber",
          "association",
          "address",
          "officeAddress",
          "barangay",
          "municipality",
          "province",
          "region",
          "position",
          "profileBio",
          "members",
          "year",
          "status",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]);

      allow update: if isEngineer()
        || (
          isOwner(userId)
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "name",
              "contactNumber",
              "address",
              "officeAddress",
              "barangay",
              "municipality",
              "province",
              "region",
              "position",
              "profileBio",
              "avatar",
              "updatedAt"
            ])
        );

      allow delete: if false;
    }

    match /accountRequests/{accountRequestId} {
      allow read: if isEngineer();

      allow create: if validAccountRequest();

      allow update: if isEngineer()
        && resource.data.status == "pending"
        && request.resource.data.status == "approved"
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.approvedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "status",
            "approvedAt",
            "approvedBy",
            "updatedAt"
          ]);

      allow delete: if isEngineer();
    }

    match /requests/{requestId} {
      allow read: if isEngineer()
        || (
          signedIn()
          && resource.data.clientId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid;

      allow update: if isEngineer()
        || (
          signedIn()
          && resource.data.clientId == request.auth.uid
        );

      allow delete: if isEngineer();
    }

    match /documents/{documentId} {
      allow read: if isEngineer()
        || (
          signedIn()
          && resource.data.clientId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid;

      allow update: if isEngineer()
        || (
          signedIn()
          && resource.data.clientId == request.auth.uid
        );

      allow delete: if isEngineer();

      match /chunks/{chunkId} {
        allow read: if isEngineer()
          || (
            signedIn()
            && get(
              /databases/$(database)/documents/documents/$(documentId)
            ).data.clientId == request.auth.uid
          );

        allow create: if signedIn()
          && get(
            /databases/$(database)/documents/documents/$(documentId)
          ).data.clientId == request.auth.uid;

        allow update, delete: if isEngineer();
      }
    }

    match /reportDocuments/{documentId} {
      allow read: if isEngineer();

      allow create: if isEngineer()
        && request.resource.data.engineerId == request.auth.uid;

      allow update, delete: if isEngineer();

      match /chunks/{chunkId} {
        allow read, create, update, delete: if isEngineer();
      }
    }

    match /appointments/{appointmentId} {
      allow read: if isEngineer()
        || (
          signedIn()
          && resource.data.clientId == request.auth.uid
        );

      allow create: if isEngineer()
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if isEngineer();
    }

    match /blockedDates/{dateId} {
      allow read: if signedIn();

      allow create: if isEngineer()
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if isEngineer();
    }

    match /fullyBookedDates/{dateId} {
      allow read: if signedIn();

      allow create: if isEngineer()
        && request.resource.data.date == dateId
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if isEngineer();
    }

    match /notifications/{notificationId} {
      allow read: if isEngineer()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isEngineer()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );
    }

    match /messages/{messageId} {
  allow read: if signedIn()
    && request.auth.uid in resource.data.participants;

  allow create: if signedIn()
    && request.auth.uid in request.resource.data.participants;

  allow update: if isEngineer()
    || (
      signedIn()
      && request.auth.uid in resource.data.participants
    );

  allow delete: if isEngineer()
    || (
      signedIn()
      && request.auth.uid in resource.data.participants
    );
  }
    }
      }