rules_version = '2';

service cloud.firestore {
match /databases/{database}/documents {

function signedIn() {
  return request.auth != null;
}

function isEngineer() {
  return signedIn()
    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "engineer"
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != "inactive";
}

function isOwner(userId) {
  return signedIn() && request.auth.uid == userId;
}

match /users/{userId} {
  allow read: if signedIn();

  allow create: if signedIn()
    && request.auth.uid == userId;

  allow update: if isEngineer()
    || isOwner(userId);

  allow delete: if false;
}

match /requests/{requestId} {
  allow read: if signedIn();

  allow create: if signedIn()
    && request.resource.data.clientId == request.auth.uid;

  allow update: if isEngineer()
    || (
      signedIn()
      && resource.data.clientId == request.auth.uid
    );

  allow delete: if isEngineer();
}

match /documents/{documentId} {
  allow read: if signedIn();

  allow create: if signedIn()
    && request.resource.data.clientId == request.auth.uid;

  allow update: if isEngineer()
    || (
      signedIn()
      && resource.data.clientId == request.auth.uid
    );

  allow delete: if isEngineer();

  match /chunks/{chunkId} {
    allow read: if signedIn();

    allow create: if signedIn();

    allow update: if isEngineer();

    allow delete: if isEngineer();
  }
}

match /reportDocuments/{documentId} {
  allow read: if signedIn();

  allow create: if isEngineer()
    && request.resource.data.engineerId == request.auth.uid;

  allow update: if isEngineer();

  allow delete: if isEngineer();

  match /chunks/{chunkId} {
    allow read: if isEngineer();

    allow create: if isEngineer();

    allow update: if isEngineer();

    allow delete: if isEngineer();
  }
}

match /appointments/{appointmentId} {
  allow read: if signedIn();

  allow create: if isEngineer()
    && request.resource.data.createdBy == request.auth.uid;

  allow update: if isEngineer();

  allow delete: if isEngineer();
}

match /blockedDates/{dateId} {
  allow read: if signedIn();

  allow create: if isEngineer()
    && request.resource.data.createdBy == request.auth.uid;

  allow update: if isEngineer();

  allow delete: if isEngineer();
}

match /notifications/{notificationId} {
  allow read: if isEngineer()
    || (
      signedIn()
      && resource.data.userId == request.auth.uid
    );

  allow create: if signedIn();

  allow update: if isEngineer()
    || (
      signedIn()
      && resource.data.userId == request.auth.uid
    );

  allow delete: if isEngineer()
    || (
      signedIn()
      && resource.data.userId == request.auth.uid
    );
}

match /messages/{messageId} {
  allow read: if isEngineer()
    || (
      signedIn()
      && request.auth.uid in resource.data.participants
    );

  allow create: if signedIn()
    && request.auth.uid in request.resource.data.participants;

  allow update: if isEngineer()
    || (
      signedIn()
      && request.auth.uid in resource.data.participants
    );

  allow delete: if isEngineer()
    || (
      signedIn()
      && request.auth.uid in resource.data.participants
    );
}

}
}
